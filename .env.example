# Farm Command — environment template. Copy to .env and adjust.
# NEVER commit your real .env.

# Server database (Prisma) — PostgreSQL connection string.
# Get a FREE one from Neon (https://neon.tech) or Vercel Postgres, then paste it
# here AND into your Vercel project's Environment Variables. Example shape:
#   postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
# Use the same URL on your laptop and on Vercel so every device shares one
# database and stays in sync.
DATABASE_URL=

# Web Push (VAPID) — enables server-delivered reminder notifications.
# Generate your own: bunx web-push generate-vapid-keys
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_CONTACT=mailto:you@example.com

# Optional access gate (recommended when hosting on the public internet).
# Leave BLANK to disable (default: no gate, account-free like before).
# When set, browsers unlock once at /unlock (stores an httpOnly cookie) and
# programmatic callers (e.g. the push cron) send:
#   Authorization: Bearer <FARM_ACCESS_TOKEN>
# Use a long random value, e.g.:  openssl rand -base64 32
FARM_ACCESS_TOKEN=
